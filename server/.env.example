# Copy to .env and fill in for your environment. Loaded automatically via
# dotenv in config.js -- for production hosting, set these as real
# environment variables on the platform instead of shipping a .env file.

# Port the API + Socket.IO server listens on
PORT=4000

# Absolute path to the SQLite database file. In production this MUST point
# at a persistent volume/disk -- most hosting platforms (Render, Railway,
# Fly.io, etc.) have an ephemeral filesystem by default, so without a
# mounted persistent volume your data is wiped on every redeploy/restart.
DB_PATH=/absolute/path/to/persistent/scrapswap.db

# Secret used to sign JWTs. REQUIRED in production (server refuses to start
# without it when NODE_ENV=production) -- generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Comma-separated list of allowed frontend origins, e.g.
# CORS_ORIGIN=https://scrapswap.example.com,https://staging.scrapswap.example.com
CORS_ORIGIN=http://localhost:5173

NODE_ENV=production
